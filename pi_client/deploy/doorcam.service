[Unit]
Description=Door Cam Pi Client (WebSocket publisher to MagicMirror hub)
After=network-online.target
Wants=network-online.target

[Service]
# User that owns /opt/doorcam and the webcam group membership.
# Override with a drop-in (systemctl edit doorcam) if you use a different user.
User=pi
Group=pi

WorkingDirectory=/opt/doorcam/pi_client
ExecStart=/opt/doorcam/pi_client/.venv/bin/python -m doorcam

# Auto-restart on crash, but don't hammer the CPU if something is fundamentally broken.
Restart=on-failure
RestartSec=3

# Pass through the config path if you want a non-default location.
# Environment=DOORCAM_CONFIG=/etc/doorcam/config.yml

# Safer defaults.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
